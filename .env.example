# SQL Server 2025 Express (local)
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=CommanderDeckBuilder
SQL_USER=
SQL_PASSWORD=
SQL_TRUSTED_CONNECTION=true
SQL_TRUST_SERVER_CERTIFICATE=true

# External sources
HTTP_USER_AGENT=commander-deck-builder/0.1 (personal)
EDHREC_MIN_DELAY_MS=2500
EDHREC_CACHE_DAYS=7

# Prices
USD_TO_EUR=0.92   # fallback only, when a card has no Cardmarket price (flagged as estimate)

# Optional, Phase 4 only: Claude API key for one-click builds (Pro plan does not include API access)
ANTHROPIC_API_KEY=

# Forge (Phase 2)
FORGE_JAR=
FORGE_WORKERS=3
